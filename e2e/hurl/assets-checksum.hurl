# GET /assets/checksum/{filename}
# The same route as GET /assets/binary/{filePath}, under another name, used for checksums files.

GET {{url}}/assets/checksum/bin.local%2Fassets%2Fbinaries%2Fgitlab%2Fv0.1.0%2Fgitlab_0.1.0_checksums.txt
HTTP 200
[Asserts]
header "Content-Type" == "application/octet-stream"
header "Content-Disposition" == "attachment; filename=gitlab_0.1.0_checksums.txt"
sha256 == hex,b1a61d53873cc29e3fe4218ae72938fb5dcc9e6af902e33c71a4cb06f6a3730d;
body contains "8ce6a6ede1b221e225d57e882740143ad598fa99c5493296086466b9f119f08f  gitlab_0.1.0_darwin_arm64.tar.gz"

# The checksums.txt generated by publish in folder mode.
GET {{url}}/assets/checksum/bin.local%2Fassets%2Fbinaries%2Fbilling-db-migrations%2Fv1.0.0%2Fchecksums.txt
HTTP 200
[Asserts]
body contains "cde6915139e6cf8cf66b69977ae8b8b3bb6b5ed911f87faa802982f12dad9a21  billing-db-migrations_1.0.0.tar.gz"

GET {{url}}/assets/checksum/bin.local%2Faudit.log
HTTP 404

GET {{url}}/assets/checksum/bin.local%2Fassets%2Fbinaries%2Fgitlab%2Fv0.1.0%2Fmissing_checksums.txt
HTTP 404
